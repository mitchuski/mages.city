{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "City proverb root archive \u2014 observer draft 0.1",
  "description": "Public approved projections only. Schema validation does not verify signatures or authorize acceptance. Accepted roots require decision-policy verification outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "community",
    "roots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1-draft"
    },
    "status": {
      "const": "local-design-preview"
    },
    "community": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "proverb",
          "sources",
          "reviews",
          "decision",
          "visibility",
          "supersedes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "proverb": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tomeId",
                "version",
                "locator",
                "disclosureBasis"
              ],
              "properties": {
                "tomeId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "disclosureBasis": {
                  "type": "string",
                  "minLength": 1
                },
                "publicExcerpt": {
                  "type": "string"
                },
                "approvedPublicHash": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewer",
                "stance",
                "rationale",
                "evidence",
                "verificationStatus"
              ],
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "stance": {
                  "enum": [
                    "agree",
                    "dissent",
                    "abstain"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "verificationStatus": {
                  "enum": [
                    "unverified",
                    "verified",
                    "invalid",
                    "unavailable"
                  ]
                },
                "signedRecordRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "community",
              "policyRef",
              "recordRef"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "under-review",
                  "accepted-root",
                  "disputed",
                  "superseded",
                  "withdrawn"
                ]
              },
              "community": {
                "type": "string",
                "minLength": 1
              },
              "policyRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recordRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "visibility": {
            "enum": [
              "public-approved-projection"
            ]
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}